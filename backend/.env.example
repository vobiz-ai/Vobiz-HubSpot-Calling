# ─── Vobiz account ───────────────────────────────────────────────────────────
# One account owns the SIP endpoint, the caller ID and the balance. They are not
# interchangeable: Vobiz rejects a `from` number the account does not own.
VOBIZ_AUTH_ID=MA_XXXXXXXX
VOBIZ_AUTH_TOKEN=
VOBIZ_FROM_NUMBER=+91XXXXXXXXXX
VOBIZ_API_URL=https://api.vobiz.ai

# ─── SIP endpoints ───────────────────────────────────────────────────────────
# Leave BOTH empty (recommended): each agent gets their own endpoint on first
# sign-in, and the agent -> endpoint-id map is kept in AGENT_ENDPOINT_STORE
# (no passwords; a fresh one is set on every sign-in).
#
# Set both ONLY for a single-agent install that registers as one existing
# endpoint. Two agents on one endpoint race for every inbound call.
# POST /Endpoint/ REWRITES the username you submit; put the STORED one here.
VOBIZ_SIP_USER=
VOBIZ_SIP_PASSWORD=
# AGENT_ENDPOINT_STORE=./agent-endpoints.json
# SESSION_TTL_HOURS=12
VOBIZ_REGISTRAR=registrar.vobiz.ai

# ─── Public reachability ─────────────────────────────────────────────────────
# Vobiz must reach /answer, /dial-status and /recording-ready over public HTTPS.
# A dead answer URL produces the exact symptom people blame on registration:
# the customer answers, hears ringback, then "the agent could not be reached".
PUBLIC_BASE=https://your-tunnel-or-domain.example.com

PORT=8092

# ─── Recording link signing ──────────────────────────────────────────────────
# Playback URLs are HMAC-signed with a short expiry and carry no credentials.
# Left blank, a new secret is generated each restart and old links stop working.
SIGNING_SECRET=
RECORDING_URL_TTL_SECONDS=900

# ─── HubSpot ─────────────────────────────────────────────────────────────────
# From the app's Auth tab in Development > Projects > your app.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Must match permittedUrls / redirectUrls in src/app/app-hsmeta.json EXACTLY.
HUBSPOT_REDIRECT_URI=https://your-public-host/hubspot/callback
HUBSPOT_SCOPES=oauth

# For scripts/enable-inbound-calling.js. Inbound is OFF until that runs.
HUBSPOT_APP_ID=
HUBSPOT_DEVELOPER_API_KEY=

# Extra browser origins allowed to call this backend, comma separated.
# *.hubspot.com, localhost and PUBLIC_BASE's own origin are allowed by default.
ALLOWED_ORIGINS=
