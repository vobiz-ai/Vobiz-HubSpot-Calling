# Deployment settings only. There is NO Vobiz account in this file: each agent
# signs in from the panel with their own Vobiz Auth ID + Auth Token (or, in SIP
# direct mode, an existing endpoint's SIP credentials). Endpoints and the
# Vobiz application are created in the agent's own account at sign-in.

PORT=8092

# ─── Public reachability ─────────────────────────────────────────────────────
# Vobiz must reach /answer, /dial-status and /recording-ready over public HTTPS.
# This becomes the answer_url of the application created in each account.
# A dead answer URL produces the exact symptom people blame on registration:
# the customer answers, hears ringback, then "the agent could not be reached".
PUBLIC_BASE=https://calling.example.com

# ─── Recording link signing ──────────────────────────────────────────────────
# Playback URLs are HMAC-signed (account + recording + expiry) and carry no
# credentials. Left blank, a new secret is generated each restart and old links
# stop working.
SIGNING_SECRET=
RECORDING_URL_TTL_SECONDS=900

# ─── Agent state ─────────────────────────────────────────────────────────────
# Runtime state directory, created 0700; files in it are 0600. Relative paths
# are taken from backend/. Holds agent-endpoints.json (authId:agentId ->
# endpoint id + username, no passwords) and hubspot-tokens.json (the OAuth
# refresh token). Files left in backend/ by older versions are read once and
# rewritten here.
# DATA_DIR=./data
# Overrides the endpoint map's path outright (no migration).
# AGENT_ENDPOINT_STORE=
# SESSION_TTL_HOURS=12

# ─── Vobiz hosts (leave the defaults) ────────────────────────────────────────
# VOBIZ_API_URL=https://api.vobiz.ai
# VOBIZ_REGISTRAR=registrar.vobiz.ai

# ─── HubSpot ─────────────────────────────────────────────────────────────────
# From the app's Auth tab in Development > Projects > your app.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Must match permittedUrls / redirectUrls in src/app/app-hsmeta.json EXACTLY.
HUBSPOT_REDIRECT_URI=https://calling.example.com/hubspot/callback
# Defaults to `oauth`, matching requiredScopes in app-hsmeta.json. Extra scopes
# make the install demand CRM permissions agents do not have.
HUBSPOT_SCOPES=oauth

# For scripts/configure-calling.js (registers the widget, enables inbound in
# HubSpot). It reads this file; shell variables override it. The widget URL
# defaults to ${PUBLIC_BASE}/widget/.
HUBSPOT_APP_ID=
HUBSPOT_DEVELOPER_API_KEY=
# WIDGET_URL=

# Extra browser origins allowed to call this backend, comma separated.
# *.hubspot.com, localhost and PUBLIC_BASE's own origin are allowed by default.
ALLOWED_ORIGINS=
